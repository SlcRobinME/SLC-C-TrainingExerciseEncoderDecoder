			<![CDATA[using System;
using System.Collections.Generic;
using System.Globalization;
using System.Linq;
using System.Text;

using Skyline.DataMiner.Scripting;

/// <summary>
/// DataMiner QAction Class: notAvailable.
/// </summary>
public static class QAction
{
    /// <summary>
    /// The QAction entry point.
    /// </summary>
    /// <param name="protocol">Link with SLProtocol process.</param>
    /// 
    public static readonly int[] encoderParams = new int[]
                {
                    Parameter.encoderstatus_10,
                    Parameter.currentcompressedbitrateencoder_11,
                    Parameter.autochromaweight_12,
                    Parameter.chromaweight_13,
                    Parameter.losslessmode_14
                };

    public static readonly int[] encoderBackupParams = new int[]
                {
                    Parameter.bitratebackup_15,
                    Parameter.autochromebackup_16,
                    Parameter.chromabackup_17,
                    Parameter.losslessbackup_18
                };

    public static readonly int[] decoderParams = new int[]
                {
                    Parameter.statusdecoder_20,
                    Parameter.currentcompressedbitratedecoder_21,
                    Parameter.progressionorder_22,
                    Parameter.codeblockwidth_23,
                    Parameter.codeblockheight_24
                };

    public static readonly int[] decoderBackupParams = new int[]
                {
                    Parameter.bitratebackupdecoder_25,
                    Parameter.progressionorderbackup_26,
                    Parameter.codeblockwidthbackup_28,
                    Parameter.codeblockheightbackup_27
                };
    public static void Run(SLProtocol protocol)
    {
        try
        {
            protocol.Log($"");
            var parameterValue = protocol.GetParameter(Parameter._switch_19);
            protocol.Log($"Switch value set to {parameterValue}");
            if (Convert.ToInt64(parameterValue) == 1)
            {
                disableDecoderParams(protocol);
                enableEncoderParams(protocol);
            }
            else
            {
                disableEncoderParams(protocol);
                enableDecoderParams(protocol);
            }
           
        }
        catch (Exception ex)
        {
            protocol.Log($"QA{protocol.QActionID}|{protocol.GetTriggerParameter()}|Run|Exception thrown:{Environment.NewLine}{ex}", LogType.Error, LogLevel.NoLogging);
        }
    }

    public static void disableEncoderParams(SLProtocol protocol)
    {
        var encoderParamsUint = Array.ConvertAll(encoderParams, id => (uint)id);
        var values = (object[])protocol.GetParameters(encoderParamsUint);

        protocol.SetParameters(encoderBackupParams, values.Skip(1).ToArray());
        protocol.SetParameters(encoderParams, new object[] { 0, -1, -1, -1, -1 });
    }

    public static void enableEncoderParams(SLProtocol protocol)
    {
        var backupParamsUint = Array.ConvertAll(encoderBackupParams, id => (uint)id);
        var backupValues = (object[])protocol.GetParameters(backupParamsUint);

        protocol.SetParameters(encoderParams, backupValues.Prepend(1).ToArray());
    }

    public static void disableDecoderParams(SLProtocol protocol)
    {
        var decoderParamsUint = Array.ConvertAll(decoderParams, id => (uint)id);
        var values = (object[])protocol.GetParameters(decoderParamsUint);

        protocol.SetParameters(decoderBackupParams, values.Skip(1).ToArray());
        protocol.SetParameters(decoderParams, new object[] { 0, -1, -1, -1, -1 });
    }

    public static void enableDecoderParams(SLProtocol protocol)
    {
        var backupParamsUint = Array.ConvertAll(decoderBackupParams, id => (uint)id);
        var backupValues = (object[])protocol.GetParameters(backupParamsUint);

        protocol.SetParameters(decoderParams, backupValues.Prepend(1).ToArray());
    }
}]]>
