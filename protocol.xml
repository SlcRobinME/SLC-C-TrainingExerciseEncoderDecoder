	<QActions>
		<QAction id="1" name="generateBitrate" encoding="csharp" triggers="100">
			<![CDATA[using System;
using System.Collections.Generic;
using System.Globalization;
using System.Text;

using Skyline.DataMiner.Scripting;

/// <summary>
/// DataMiner QAction Class: generateBitrate.
/// </summary>
public static class QAction
{
	/// <summary>
	/// The QAction entry point.
	/// </summary>
	/// <param name="protocol">Link with SLProtocol process.</param>
	public static void Run(SLProtocol protocol)
	{
		try
		{
			var random = new Random();
			var bitrate = random.Next(1,16);
			protocol.SetParameter(Parameter.currentcompressedbitrateencoder_11, bitrate);
		}
		catch (Exception ex)
		{
			protocol.Log($"QA{protocol.QActionID}|{protocol.GetTriggerParameter()}|Run|Exception thrown:{Environment.NewLine}{ex}", LogType.Error, LogLevel.NoLogging);
		}
	}
}]]>
		</QAction>
		<QAction id="2" name="setNotAvailable" encoding="csharp" triggers="10">
			<![CDATA[using System;
using System.Collections.Generic;
using System.Globalization;
using System.Text;

using Skyline.DataMiner.Scripting;

/// <summary>
/// DataMiner QAction Class: notAvailable.
/// </summary>
public static class QAction
{
	/// <summary>
	/// The QAction entry point.
	/// </summary>
	/// <param name="protocol">Link with SLProtocol process.</param>
	public static void Run(SLProtocol protocol)
	{
        try
        {
            var triggerParamId = protocol.GetTriggerParameter();

            if (triggerParamId == Parameter.encoderstatus_10)
            {
                var parameterValue = protocol.GetParameter(triggerParamId);
                var encoderParams = new int[]
                {
                    Parameter.currentcompressedbitrateencoder_11,
                    Parameter.autochromaweight_12,
                    Parameter.chromaweight_13,
                    Parameter.losslessmode_14
                };

                var encoderBackupParams = new int[]
                {
                    Parameter.bitratebackup_15,
                    Parameter.autochromebackup_16,
                    Parameter.chromabackup_17,
                    Parameter.losslessbackup_18
                };

                if (Convert.ToInt64(parameterValue) == 0)
                {
                    var encoderParamsUint = Array.ConvertAll(encoderParams, id => (uint)id);
                    var values = (object[])protocol.GetParameters(encoderParamsUint);

                    protocol.SetParameters(encoderBackupParams, values);
                    protocol.SetParameters(encoderParams, new object[] { -1, -1, -1, -1 });
                }
                else
                {
                    var backupParamsUint = Array.ConvertAll(encoderBackupParams, id => (uint)id);
                    var backupValues = (object[])protocol.GetParameters(backupParamsUint);

                    protocol.SetParameters(encoderParams, backupValues);
                }
            }
        }
        catch (Exception ex)
        {
            protocol.Log($"QA{protocol.QActionID}|{protocol.GetTriggerParameter()}|Run|Exception thrown:{Environment.NewLine}{ex}", LogType.Error, LogLevel.NoLogging);
        }
	}
}]]>
		</QAction>
		
